# ========================================================
# Discord Bot Configuration
# ========================================================
# Your bot token from the Discord Developer Portal:
# https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# The Application (Client) ID of your bot:
DISCORD_CLIENT_ID=your_discord_client_id_here

# (Optional) Guild ID for instant slash command registration during testing.
# If left blank, commands register globally (may take up to a few minutes).
GUILD_ID=

# ========================================================
# AzuraCast Instance Configuration
# ========================================================
# Base URL of your AzuraCast instance (NO trailing slash, e.g. https://radio.example.com):
AZURACAST_BASE_URL=https://your-azuracast-instance.com

# (Optional) AzuraCast API Key.
# Only needed if your stations are private or you restrict public API endpoints:
AZURACAST_API_KEY=

# (Optional) Default station shortcode or ID to play and display in bot status (e.g. 8):
DEFAULT_STATION=8

# ========================================================
# Bot Behavior Settings
# ========================================================
# Automatically disconnect when everyone leaves the voice channel (true/false):
AUTO_LEAVE_EMPTY_VC=true

# Seconds to wait before leaving an empty voice channel:
AUTO_LEAVE_TIMEOUT=30

# Interval (in seconds) to update bot status / Rich Presence with currently playing song:
PRESENCE_INTERVAL=30
